rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: admins can read anything (current or future collections); everything else denied unless overridden below
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() &&
             (request.auth.token.email == 'jstreet@freeatlast.st' ||
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
              (exists(/databases/$(database)/documents/participants/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/participants/$(request.auth.uid)).data.role == 'admin'));
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 256;
    }
    function isValidParticipant(data) {
      return data.keys().hasAll(['userId', 'name', 'golfClub', 'handicap']) &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.golfClub is string && data.golfClub.size() > 0 && data.golfClub.size() < 200 &&
             data.handicap is number;
    }

    // --- Collections ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
    
      allow update: if isAdmin() ||
                    (isOwner(userId) &&
                     !incoming().diff(existing()).affectedKeys().hasAny(['role', 'status']));
    
      allow delete: if isAdmin();

      match /private/info {
        allow get: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
                               incoming().email is string &&
                               incoming().email.size() < 256;
      }

      // Index of the lobbies this user belongs to, so "my lobbies" is a plain
      // owner-scoped list — no collection-group index, and no get() calls that
      // would burn the 10-document-access budget a query is allowed.
      // Entries are only ever written by the server (create-lobby/join-lobby,
      // via firebase-admin, which bypasses these rules) — clients may read
      // their own and delete one when leaving or when a creator/admin kicks.
      match /lobbyMemberships/{lobbyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if false;
        allow delete: if isOwner(userId) ||
                      isAdmin() ||
                      get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.creatorId == request.auth.uid;
      }

      // Final standings from a finished lobby this user took part in —
      // written once by finishLobby() server-side, never by the client.
      match /history/{lobbyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /participants/{userId} {
      allow get: if isSignedIn();
      allow list: if true;

      allow create: if isAdmin() ||
                     (isOwner(userId) &&
                     isValidId(userId) &&
                     isValidParticipant(incoming()) &&
                     incoming().userId == userId &&
                     incoming().get('paidRounds', 0) == 0 &&
                     incoming().get('usedRounds', 0) == 0 &&
                     incoming().get('role', 'user') == 'user');

      allow update: if isAdmin() || (isOwner(userId) &&
                     isValidParticipant(incoming()) && (
                       (incoming().diff(existing()).affectedKeys().hasOnly([
                         'location', 'updatedAt', 'name', 'golfClub', 'course', 'handicap',
                         'email', 'emailLower', 'membershipProofUrl', 'membershipProofFileName',
                         'membershipProofUploadedAt', 'avatarUrl'
                       ])) ||
                       (incoming().diff(existing()).affectedKeys().hasOnly(['score', 'updatedAt']) &&
                        incoming().score is number && incoming().score >= 0 && incoming().score <= 100)
                     ));

      allow delete: if isAdmin();

      match /private/info {
        allow get: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
                               incoming().email is string &&
                               incoming().email.size() < 256;
      }
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isSignedIn() &&
                    isValidId(scoreId) &&
                    incoming().participantId == request.auth.uid &&
                    incoming().points is number &&
                    incoming().points >= 0 &&
                    incoming().points <= 100;
      allow update, delete: if isAdmin();
    }

    // --- Analytics (Daily App Usage tab) ---
    // Write is open to everyone (including logged-out visitors) since
    // that's who's being counted; read stays admin-only via the default rule.
    match /dailyAppStats/{day} {
      allow write: if incoming().date is string &&
                   incoming().totalVisits is number;
    }

    // --- Content & communication (Content & Newsletter tab) ---
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletter_subscribers/{id} {
      allow write: if isAdmin();
    }

    match /newsletters/{id} {
      allow write: if isAdmin();
    }

    // --- Community needs / requests broadcast (Community Needs tab) ---
    match /needs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Warnings / moderation log (Warnings & Alerts tab) ---
    match /warnings/{id} {
      allow write: if isAdmin();
    }

    // --- Lobbies ---
    // Every status transition (create, join, start — which charges credits,
    // finish — which scores and archives, delete, maintenance) happens
    // server-side via firebase-admin, which bypasses these rules entirely.
    // Clients never create a lobby, a member, a scorecard result, or a
    // history entry directly, and never touch status/startedAt/finishedAt/
    // expiresAt/chargeStatus — only the server-side endpoints in /api do.
    function lobbyData(lobbyId) {
      return get(/databases/$(database)/documents/lobbies/$(lobbyId)).data;
    }

    function isLobbyMember(lobbyId, uid) {
      return exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(uid));
    }

    function isChargedMember(lobbyId, uid) {
      return isLobbyMember(lobbyId, uid) &&
             get(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(uid)).data.get('chargeStatus', '') == 'charged';
    }

    function lobbyIsLive(lobbyId) {
      return lobbyData(lobbyId).status == 'live';
    }

    match /lobbies/{lobbyId} {
      // Every lobby is publicly listed/visible — closed lobbies just can't be
      // joined without the share code, which lives in the restricted
      // secret/join subdocument below, never on this document.
      allow read: if true;

      // Creation charges nothing but still needs the credit/active-lobby
      // checks that only the server can cheaply and atomically perform —
      // use POST /api/create-lobby.
      allow create: if false;

      // The host can still edit a few harmless details before the event
      // starts — this stays a direct client write. Everything that matters
      // (status, credits, membership) goes through the server endpoints.
      allow update: if isAdmin() ||
                    (isSignedIn() && existing().creatorId == request.auth.uid &&
                     existing().status == 'scheduled' &&
                     incoming().diff(existing()).affectedKeys().hasOnly(['name', 'isClosed', 'eventDate', 'expiresAt', 'updatedAt']) &&
                     incoming().name is string && incoming().name.size() > 0 && incoming().name.size() < 100 &&
                     incoming().isClosed is bool &&
                     incoming().eventDate is timestamp && incoming().eventDate > request.time &&
                     incoming().expiresAt == incoming().eventDate + duration.value(12, 'h'));

      // Deletion has to clean up the membership index on every member first —
      // use POST /api/delete-lobby (creator while scheduled, or admin).
      allow delete: if false;

      // Holds the invite code for closed lobbies. Only the creator/admin can
      // ever read it back (e.g. to redisplay it for copying) — it is never
      // included on the publicly-readable lobby document above. Creation
      // stays a client write because switching an existing lobby to private
      // (via the update rule above) needs to be able to mint a fresh code.
      match /secret/join {
        allow create: if isSignedIn() &&
                      lobbyData(lobbyId).creatorId == request.auth.uid &&
                      lobbyData(lobbyId).status == 'scheduled' &&
                      incoming().code is string && incoming().code.size() >= 4 && incoming().code.size() <= 20;
        allow get: if isSignedIn() &&
                   (lobbyData(lobbyId).creatorId == request.auth.uid || isAdmin());
      }

      match /members/{memberId} {
        // Open-lobby rosters (and member counts) are visible to anyone,
        // signed in or not — matching the lobby doc's own public read rule.
        // Closed-lobby rosters are restricted to people already inside (or
        // the creator/admin), so an invite code, once used, only ever
        // reaches people who already had it.
        allow read: if !lobbyData(lobbyId).isClosed ||
                    (isSignedIn() &&
                     (isAdmin() ||
                      lobbyData(lobbyId).creatorId == request.auth.uid ||
                      exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid))));

        // Joining needs the same credit/active-lobby/code checks as create —
        // use POST /api/join-lobby.
        allow create: if false;
        allow update: if false;

        // Leaving/kicking stays a direct client write, but only before the
        // event starts — once it's live, membership (and who got charged)
        // is locked in.
        allow delete: if lobbyData(lobbyId).status == 'scheduled' &&
                      (isOwner(memberId) ||
                       isAdmin() ||
                       lobbyData(lobbyId).creatorId == request.auth.uid);
      }

      // Live GPS during a lobby's event. Only charged members (not
      // spectators) share or see it, and only while the event is live.
      match /locations/{userId} {
        allow read: if isSignedIn() &&
                    isLobbyMember(lobbyId, request.auth.uid) &&
                    lobbyIsLive(lobbyId);

        allow write: if isOwner(userId) &&
                     isChargedMember(lobbyId, userId) &&
                     lobbyIsLive(lobbyId) &&
                     incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90 &&
                     incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180 &&
                     incoming().updatedAt == request.time;
      }

      // Per-hole strokes during a live event. Only the charged player who
      // owns the card can write it, and only while their lobby is live —
      // spectators (no credit at Start) get a read-only view in the UI.
      match /scorecards/{userId} {
        allow read: if isSignedIn() &&
                    (isLobbyMember(lobbyId, request.auth.uid) || isAdmin());

        allow create, update: if isOwner(userId) &&
                              isChargedMember(lobbyId, userId) &&
                              lobbyIsLive(lobbyId) &&
                              incoming().strokes is map &&
                              incoming().strokes.size() <= lobbyData(lobbyId).holes &&
                              incoming().total is number && incoming().total >= 0 && incoming().total <= 270 &&
                              incoming().holesPlayed is number && incoming().holesPlayed >= 0 && incoming().holesPlayed <= 18 &&
                              incoming().updatedAt == request.time;

        allow delete: if false;
      }

      // Final standings, written once by finishLobby() on the server.
      match /results/{docId} {
        allow read: if isSignedIn() &&
                    (isLobbyMember(lobbyId, request.auth.uid) || isAdmin());
        allow write: if false;
      }
    }
  }
}